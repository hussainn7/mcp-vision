{
  "manifest_version": 3,
  "name": "mcp-vision Chrome Bridge",
  "version": "0.1.0",
  "description": "Lets mcp-vision use your real tabs without CDP or the automation banner.",
  "permissions": ["tabs", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:9230/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "mcp-vision" }
}
