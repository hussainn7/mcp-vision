# Copy to .env (or ~/.config/mcp-vision/.env) and fill in only what you use.
# Never commit the real file (.env is gitignored).

# =============================================================================
# Plip: the AI buddy in your MacBook's notch (`plip`)
# Hold Control+Option, talk, and it answers out loud and points at things.
# Everything below can also be set in Plip's Settings window.
# =============================================================================

# Brain: no key needed if you're signed in to one of these CLIs. Plip uses your plan:
#   Claude Code (Claude Pro/Max)  `claude auth login`
#   Codex CLI (ChatGPT Plus/Pro)  `codex login`
#   Cursor CLI (Cursor plan)      `agent login`
#   Gemini CLI (Google account)   `gemini`
# BUDDY_ENGINE=                        # claude-code | codex | cursor | gemini | anthropic ("" = best ready)
# BUDDY_CLI_MODEL=                     # optional --model for that CLI, e.g. sonnet or gpt-5-codex
# Or use an API key (fastest first word, prompt caching):
ANTHROPIC_API_KEY=
# BUDDY_MODEL=claude-opus-5-5          # any Claude model id, e.g. claude-sonnet-5-5
# BUDDY_EFFORT=low                     # low | medium | high; walkthroughs go one step higher

# Fast System-1 router (optional but recommended): TypeSafe Jev answers small
# typed questions in ~100 ms - does this need a screenshot, which monitor,
# quick answer or walkthrough - and picks the exact UI element to point at.
# Keys: https://console.typesafe.ai ($0.042 per 1M input tokens, output free)
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# BUDDY_ROUTER=auto                    # auto (Jev if keyed, else rules) | jev | rules | off
# BUDDY_SNAP_TO_ELEMENTS=true          # snap the pointer onto the real control (macOS)

# Voice out (optional): ElevenLabs sounds natural; without a key macOS `say` is used.
ELEVENLABS_API_KEY=
# BUDDY_ELEVENLABS_VOICE_ID=kPzsL2i3teMYv0FxEYQ6
# BUDDY_ELEVENLABS_MODEL=eleven_flash_v2_5
# BUDDY_TTS=auto                       # auto | elevenlabs | say | print | off

# Voice in (optional): AssemblyAI streaming; without a key Apple Speech is used.
ASSEMBLYAI_API_KEY=
# BUDDY_STT=auto                       # auto | assemblyai | apple

# BUDDY_ALWAYS_VISIBLE=true            # false: buddy only appears while working
# BUDDY_MAX_IMAGE_EDGE=1280            # screenshot size sent to the model

# =============================================================================
# MCP server / legacy contextual popup (`mcp-vision serve`, `mcp-vision ui`)
# =============================================================================

# Model for the legacy popup (Ask / Guide / Act planning):
#   openrouter (default) | auto | local | claude | chatgpt | gemini | nvidia
# SCREEN_AGENT_MODEL_BACKEND=openrouter
OPENROUTER_API_KEY=
# SCREEN_AGENT_OPENROUTER_MODEL=openai/gpt-6-luna
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# `mcp-vision serve` auto-selects --fast-policy jev when TYPESAFE_API_KEY is set.
# SCREEN_AGENT_FAST_POLICY=jev         # jev | rules | disabled

# Optional legacy local provider
# SCREEN_AGENT_OLLAMA_HOST=http://127.0.0.1:11434
# SCREEN_AGENT_PLANNING_MODEL=qwen3-coder:30b
