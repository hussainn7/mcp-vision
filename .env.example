# Copy to .env and fill in only what you use. Never commit the real file
# (.env is already gitignored).

# Model for the contextual popup (Ask / Guide / Act planning):
#   openrouter — default; fast cloud planning through OpenRouter
#   auto       — first configured cloud key, otherwise OpenRouter
#   local      — explicit legacy Ollama option; never selected automatically
#   claude / anthropic
#   chatgpt / openai / gpt
#   gemini
#   nvidia
# SCREEN_AGENT_MODEL_BACKEND=openrouter

# --- cloud backends — paste whichever keys you already have ----------------
OPENROUTER_API_KEY=
# SCREEN_AGENT_OPENROUTER_MODEL=openai/gpt-6-luna
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# --- Jev fast-policy (TypeSafe AI) -------------------------------------------
# Jev is a System-One model: typed choices/scores/probabilities in 70-500 ms.
# When set, `mcp-vision serve` auto-selects --fast-policy jev instead of rules.
# Get a key at https://jevapi.dev  ($0.042/1M input tokens, output free).
TYPESAFE_API_KEY=
# Override the auto-detected policy explicitly (jev | rules | disabled):
# SCREEN_AGENT_FAST_POLICY=jev

# --- optional legacy local provider ------------------------------------------
# SCREEN_AGENT_OLLAMA_HOST=http://127.0.0.1:11434
# SCREEN_AGENT_PLANNING_MODEL=qwen3-coder:30b
