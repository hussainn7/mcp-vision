# Copy to .env and fill in only what you use. Never commit the real file
# (.env is already gitignored). Everything here is optional — the default
# model_backend is "local", which needs none of these keys and never leaves
# the machine.

# SCREEN_AGENT_MODEL_BACKEND=local   # local | anthropic | openai | gemini | nvidia

# --- cloud backends (backends.py) — only needed if you switch to one -------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# --- local (Ollama) ----------------------------------------------------------
# SCREEN_AGENT_OLLAMA_HOST=http://localhost:11434
# SCREEN_AGENT_PLANNING_MODEL=qwen3:8b
